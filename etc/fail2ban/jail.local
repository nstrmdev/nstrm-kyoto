# /etc/fail2ban/jail.local

[DEFAULT]
bantime  = 3600 
findtime = 600
maxretry = 3

bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1w

[sshd]
enabled   = true
port      = 22
filter    = sshd
banaction = ufw
# Read SSH authentication events directly from the systemd journal.
backend   = systemd
