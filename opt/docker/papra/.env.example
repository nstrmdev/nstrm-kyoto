# Public HTTPS hostname routed through Cloudflare Tunnel.
APP_BASE_URL=https://papra.example.com

# Generate with openssl rand -hex 48
AUTH_SECRET=replace_me

# Per-file limit in bytes: 100 MB. Set 0 to remove Papra's limit.
# Cloudflare's separate request size limit still applies through the tunnel.
DOCUMENT_STORAGE_MAX_UPLOAD_SIZE=100000000

# Must match the owner of /srv/docker/papra on the host.
PUID=1001
PGID=1001

# First setup only
AUTH_IS_REGISTRATION_ENABLED=true
