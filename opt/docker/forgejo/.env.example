# Public HTTPS hostname routed through Cloudflare Tunnel.
APP_DOMAIN=git.example.com

# DNS-only hostname pointing directly to the Docker host's public IP.
SSH_DOMAIN=git-ssh.example.com

# Must match the owners of /srv/docker/forgejo/data and config on the host.
PUID=1001
PGID=1001

# Cloudflared Docker network subnet.
REVERSE_PROXY_TRUSTED_PROXIES=127.0.0.0/8,::1/128
